# Copy to frontend/.env.local. Only public browser-safe configuration belongs here.
# Used for live swap quotes; configure API CORS_ORIGIN to allow the frontend origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Public, credential-free endpoints suggested when adding QMS Testnet to a wallet.
NEXT_PUBLIC_QMS_RPC_URL=https://rpc.testnet.qms.finance
NEXT_PUBLIC_QMS_EXPLORER_URL=https://testnet.qmsscan.io
